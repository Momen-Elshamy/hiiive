MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=premast_starter
# AUTH_SECRET is auto-generated by create-premast-site
# If setting up manually, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Public site URL — used by sitemap.xml and robots.txt for absolute URLs
SITE_URL=https://your-domain.com

# Media plugin (@premast/site-plugin-media): uploads go straight to a
# DigitalOcean Spaces (or any S3-compatible) bucket that allows public-read.
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
# Optional
# DO_SPACES_CDN_URL=https://cdn.example.com
# DO_SPACES_PREFIX=uploads/
